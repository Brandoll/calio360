# ==========================================
# Calio Platform - Variables de Entorno
# ==========================================
# Copia este archivo como .env y rellena los valores.

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=calio
DB_USER=calio_user
DB_PASSWORD=calio_pass

# MongoDB
MONGO_URI=mongodb://mongo:27017/calio

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT (Compartido entre Identity Service y Gateway)
JWT_SECRET=calio-secret-key-2026-prod-very-secure-minimum-256-bits-long

# Gemini API (Requerido por ai-food-service y recipe-service)
GEMINI_API_KEY=

# Wearables OAuth (Futuro)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
APPLE_HEALTH_CLIENT_ID=
FITBIT_CLIENT_ID=
