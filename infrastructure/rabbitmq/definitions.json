{
  "rabbit_version": "3.12",
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    {
      "name": "calio.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    { "name": "calio.analytics.food", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "calio.analytics.exercise", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "calio.notifications.water", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "calio.notifications.exercise", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "calio.notifications.goal", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "calio.notifications.send", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.analytics.food",
      "destination_type": "queue",
      "routing_key": "food.registered",
      "arguments": {}
    },
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.analytics.exercise",
      "destination_type": "queue",
      "routing_key": "activity.updated",
      "arguments": {}
    },
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.notifications.water",
      "destination_type": "queue",
      "routing_key": "meal.updated",
      "arguments": {}
    },
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.notifications.exercise",
      "destination_type": "queue",
      "routing_key": "activity.updated",
      "arguments": {}
    },
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.notifications.goal",
      "destination_type": "queue",
      "routing_key": "goal.completed",
      "arguments": {}
    },
    {
      "source": "calio.events",
      "vhost": "/",
      "destination": "calio.notifications.send",
      "destination_type": "queue",
      "routing_key": "notification.send",
      "arguments": {}
    }
  ]
}